# These public variables must be set on the build host before next build.
# Exact application origin (no path). Supabase allowlist: this origin/auth/callback.
# Google redirect URI is DIFFERENT: Supabase project URL/auth/v1/callback.
# See AUTH_SETUP.md for production/development URL and Google branding settings.
NEXT_PUBLIC_SITE_URL=https://your-app.example
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
# Database feature switch is authoritative. Seed script reads this (default true).
SHOW_SAMPLE_PROFILES=true
# Local seeding process only. Never prefix this with NEXT_PUBLIC_ or deploy it to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
